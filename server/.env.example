# انسخي هذا الملف باسم .env (بدون example) واملئي القيم. لا ترفعي .env إلى GitHub أبداً.
PORT=5000
# للتجربة المحلية:
MONGO_URI=mongodb://127.0.0.1:27017/forge
# المواقع المسموح لها بالاتصال بالخادم (مفصولة بفاصلة). عند النشر أضيفي رابط Vercel
CLIENT_ORIGIN=http://localhost:5173
# مفتاح سري لصفحات المشرفة (اخترعي نصاً طويلاً)
ADMIN_KEY=change-me-to-a-long-random-text
# عدد أكواد الجائزة
PRIZE_LIMIT=100
