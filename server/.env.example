# انسخي هذا الملف باسم .env (بدون example) واملئي القيم. لا ترفعي .env إلى GitHub أبداً.
PORT=5000
# للتجربة المحلية:
MONGO_URI=mongodb://127.0.0.1:27017/forge
# المواقع المسموح لها بالاتصال بالخادم (مفصولة بفاصلة). عند النشر أضيفي رابط Vercel
CLIENT_ORIGIN=http://localhost:5173
# مفتاح سري لصفحات المشرفة (اخترعي نصاً طويلاً)
ADMIN_KEY=change-me-to-a-long-random-text
# عدد أكواد الجائزة
PRIZE_LIMIT=100

# المفتاح الذي تملكينه في secrets.txt
GEMINI_KEY=
# نموذج Gemini (اختياري)
GEMINI_MODEL=gemini-3.5-flash-lite
# true = المساعد يرد ردوداً تجريبية بلا إنترنت (للتطوير)
AI_MOCK=false
# كلمة السر الثالثة (مفصولة بفاصلة). يجب أن تكون مكتوبة في فقرة "من أنا"
SECRET_WORDS=قهوة,coffee
# الحد الأقصى لأسئلة المساعد في اليوم كله (يحمي حصة Gemini المجانية)
DAILY_CHAT_LIMIT=300
# اسمك كما يعرفه المساعد
OWNER_NAME=Sara
